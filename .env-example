# ============================================
# SYNAI - Variables de Entorno
# ============================================
# Copia este archivo a ".env" y completa los valores.
#   cp .env-example .env
#
# ⚠️ NUNCA subas el archivo .env al repositorio (ya está ignorado).
# Obtén cada clave desde el panel de su respectivo proveedor.
# ============================================

# ---------- URL Base ----------
# Dominio público del sitio (usado en sitemap, robots y Open Graph).
NEXT_PUBLIC_BASE_URL=https://synai.dev

# ---------- EmailJS (formulario de contacto) ----------
# Crea una cuenta en https://www.emailjs.com y un servicio + plantilla.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# ---------- Geoapify (mapa de contacto) ----------
# Obtén tu API Key en https://www.geoapify.com
NEXT_PUBLIC_GEOAPIFY_API_KEY=your_geoapify_api_key

# ---------- Google Genkit (Gemini - SEO metadata) ----------
# Clave de Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_GENAI_API_KEY=your_google_genai_api_key
